# Frontend-safe Supabase credentials only.
# Find these in Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Never place SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY in this file.
# Configure server-only secrets with `supabase secrets set` instead.
